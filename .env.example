# ── Server ────────────────────────────────────────────────────────────────────
PUBLIC_URL=https://your-ngrok-url.ngrok-free.app
HOST=0.0.0.0
PORT=8000

# ── Super Admin (your master login) ──────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=change-this-strong-password

# ── JWT Secret (generate a random string) ────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-string

# ── n8n Integration ──────────────────────────────────────────────────────────
# After deploying n8n, paste the webhook base URL here
# Example: https://your-n8n.railway.app/webhook
# Leave empty to disable n8n (app still works without it)
N8N_WEBHOOK_BASE_URL=

# NOTE: Clients enter their OWN Vapi, Anthropic, and Twilio keys
# via the Setup Wizard in the dashboard. No keys needed here.
